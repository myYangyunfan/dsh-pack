{
  "name": "@dsh-pack/dsh-goal-completion",
  "version": "0.1.0",
  "description": "目标收尾：内核右栏里的一个标签页，显示当前会话目标的状态机，并补上官方 GoalBar 没暴露的 complete 动词。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "entry": "client",
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0-rc.6 <2",
    "@deepseek-ai/dsh": ">=0.1.0-rc.6 <2"
  }
}
