{
  "name": "@dsh-pack/dsh-prompt-optimizer",
  "version": "3.0.0",
  "description": "提示词优化插件（vendored from Y1X1n/dsh-prompt-optimizer 0.6.1，MIT）：输入框旁一键分析并优化提示词草稿，结果流式上屏。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Y1X1n/dsh-prompt-optimizer.git"
  },
  "bugs": {
    "url": "https://github.com/Y1X1n/dsh-prompt-optimizer/issues"
  },
  "homepage": "https://github.com/Y1X1n/dsh-prompt-optimizer#readme",
  "keywords": [
    "deepseek",
    "dsh",
    "harness",
    "prompt",
    "optimizer",
    "plugin",
    "cordis"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.0-rc.7 <0.3.0-0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "src/",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.1",
    "esbuild": "^0.24.0",
    "react": "^18.2.0",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
