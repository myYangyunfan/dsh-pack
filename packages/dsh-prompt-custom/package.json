{
  "name": "@dsh-pack/dsh-prompt-custom",
  "version": "0.1.1",
  "description": "在 DSH 设置页自定义官方内核注入的提示词（替换整体/追加，应用到 standard 完整 Agent 基准预设）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-primitives/client"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6 <2",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.6 <2",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.6 <2",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.6 <2",
    "react": ">=18"
  },
  "files": [
    "LICENSE",
    "cordis.patch.yml",
    "lib"
  ]
}
