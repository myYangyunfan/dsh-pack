    "@dsh-pack/dsh-file-changes": "^0.1.0",
    "@dsh-pack/dsh-client-file-changes": "^0.1.0",
    "@dsh-pack/dsh-file-drop": "^0.3.0",
    "@dsh-pack/dsh-image-paste": "^0.1.0",
    "@dsh-pack/dsh-input-fold": "^0.1.0",
    "@dsh-pack/dsh-input-history": "^0.1.0",
    "@dsh-pack/dsh-auto-compact": "^0.1.0",
    "@dsh-pack/dsh-change-review": "^0.1.0",
    "@dsh-pack/dsh-offpeak": "^1.0.0",
    "@dsh-pack/dsh-settings-nav-custom": "^0.1.0",
    "@dsh-pack/dsh-settings-groups": "^0.1.0",
    "@dsh-pack/dsh-conversation-tweaks": "^0.1.0",
    "@dsh-pack/dsh-quest-ui": "^0.6.0",
    "@dsh-pack/dsh-subagent-lens": "^0.1.0",
    "@dsh-pack/dsh-easyrewrite": "^2.5.2",
    "@dsh-pack/dsh-workspace-anchor": "^0.1.0",
    "@dsh-pack/dsh-prompt-custom": "^0.1.1"
