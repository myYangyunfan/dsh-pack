{
  "name": "dsh-pack",
  "version": "0.2.0",
  "description": "DSH Pack —— 装进官方 DeepSeek Harness 客户端的插件整合包",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myYangyunfan/dsh-pack.git"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.7.0",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.0-rc.6 <2"
  },
  "dependencies": {
    "acp-kernel": "0.0.24",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "canvas-confetti": "^1.9.4",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "semver": "^7.7.3",
    "ws": "^8.18.0",
    "yaml": "^2.9.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@deepseek-ai/dsh": "0.2.0-rc.1"
  },
  "scripts": {
    "audit": "node tools/audit/index.js",
    "meta": "node tools/build-meta-patches.mjs",
    "test": "node --test \"packages/*/test/*.test.js\" \"packages/*/test/*.test.mjs\"",
    "itest": "node tools/itest/boot-desktop-profile.mjs --job=j1",
    "pack-audit": "node tools/itest/pack-audit.mjs",
    "check-syntax": "node tools/audit/syntax.js"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin-pack"
  ]
}
